{
  "name": "claude-chat-client",
  "version": "1.1.0",
  "type": "module",
  "description": "A web-based chat interface for Claude via Anthropic Vertex AI SDK",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/setup-env.js",
    "service:start": "pm2 start ecosystem.config.cjs",
    "service:stop": "pm2 stop claude-chat",
    "service:restart": "pm2 restart claude-chat",
    "service:logs": "pm2 logs claude-chat",
    "service:status": "pm2 status"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.70",
    "@anthropic-ai/vertex-sdk": "^0.14.4",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "file-type": "^20.5.0",
    "multer": "^2.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
